import getopt
import math
import os
import re
import subprocess
import sys
import time

us = os.path.basename(sys.argv[0])

# ----------------------------------------------------------------
textdefault = "\033[0m"
fg_red = "\033[31;01m"
fg_green = "\033[32;01m"
fg_yellow = "\033[33;01m"
fg_white = "\033[37;01m"
bold = "\033[1;01m"
underline = "\033[4;01m"

bg_green = "\033[42;01m"
bg_yellow = "\033[43;01m"
bg_red = "\033[41;01m"

# 64 bytes from 172.19.248.2: icmp_seq=4 ttl=64 time=2.020 ms
REPLY_TIME_RE = re.compile(r"time[=<]([0-9.]+)\s*ms")

# Lines from external ping that mean a probe failed, as opposed to header,
# blank and summary lines which are not probes at all.
#   macOS: Request timeout for icmp_seq 6
#   Linux: no answer yet for icmp_seq=6
FAILURE_LINE_RE = re.compile(r"timeout|no answer|unreachable|unknown host|cannot resolve", re.IGNORECASE)


# ================================================================
def usage(exit_code):
    stream = sys.stdout if exit_code == 0 else sys.stderr
    print("Usage: %s [options] {dest}" % us, file=stream)
    print("Options:", file=stream)
    print("-6  use script-internal IPv6", file=stream)
    print("-x  Read ping lines from external ping, e.g. ping 8.8.8.8 | %s -x" % us, file=stream)
    print("    in which case dest is not required.", file=stream)
    print("-i {wait seconds} Time between pings", file=stream)
    print("-h  Print this message", file=stream)
    sys.exit(exit_code)


# ================================================================
class Pinger:
    """Pings a host by running the system ping command once per call."""

    def __init__(self, host, timeout=5):
        self.host = host
        self.timeout = timeout
        self.exception = None

    def _command(self, ipv6):
        t = str(self.timeout)
        if sys.platform == "darwin":
            if ipv6:
                # macOS ping6 has no timeout flag; subprocess timeout covers it.
                return ["ping6", "-c", "1", self.host]
            return ["ping", "-c", "1", "-t", t, self.host]
        if ipv6:
            return ["ping", "-6", "-c", "1", "-W", t, self.host]
        return ["ping", "-c", "1", "-W", t, self.host]

    def _run(self, ipv6):
        """Returns the round-trip time in seconds, or None on failure."""
        self.exception = None
        t1 = time.time()
        try:
            result = subprocess.run(
                self._command(ipv6),
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                timeout=self.timeout + 1,
            )
        except subprocess.TimeoutExpired:
            return None
        except OSError as e:
            self.exception = str(e)
            return None
        t2 = time.time()

        if result.returncode != 0:
            err = result.stderr.strip()
            if err:
                self.exception = err.splitlines()[0]
            return None

        # Prefer the RTT that ping itself reports: wall time also includes
        # process startup, which dwarfs sub-millisecond RTTs.
        m = REPLY_TIME_RE.search(result.stdout)
        if m:
            return float(m.group(1)) / 1000.0
        return t2 - t1

    def ping(self):
        return self._run(False)

    def ping6(self):
        return self._run(True)


# ----------------------------------------------------------------
def main():
    use_ipv6 = False
    parse_external_ping = False
    wait_seconds = 1.0

    try:
        opts, args = getopt.gnu_getopt(sys.argv[1:], "6xi:h", ["help"])
        for opt, arg in opts:
            if opt == "-6":
                use_ipv6 = True
            elif opt == "-x":
                parse_external_ping = True
            elif opt == "-i":
                wait_seconds = float(arg)
            elif opt in ("-h", "--help"):
                usage(0)
    except (getopt.GetoptError, ValueError):
        usage(1)

    if not parse_external_ping and len(args) < 1:
        print("%s: need ping destination" % us, file=sys.stderr)
        sys.exit(1)

    # With -x there are no destinations to ping; the label comes from each
    # input line instead.
    if parse_external_ping:
        dests = [""]
        pingers = [None]
    else:
        dests = args
        pingers = [Pinger(dest) for dest in dests]

    count = 0
    ngood = 0
    nbad = 0

    dindex = 0
    while True:
        dest = dests[dindex]
        pinger = pingers[dindex]
        dindex = (dindex + 1) % len(pingers)

        if parse_external_ping:
            line = sys.stdin.readline()
            if line == "":
                break

            rtt = None

            # 64 bytes from 172.19.248.2: icmp_seq=4 ttl=64 time=2.020 ms
            # 16 bytes from 7f54:deed:7191:c078:abcd::83:0, icmp_seq=1 hlim=111 time=2187.003 ms
            m = re.search(r"bytes from (.*). icmp_seq.*time=(.*) ms", line)
            if m:
                dests[0] = dest = m.group(1)
                rtt = float(m.group(2)) / 1000.0
            elif not FAILURE_LINE_RE.search(line):
                # Header, blank and summary lines are not probes.
                continue

        else:
            t1 = time.time()
            rtt = pinger.ping6() if use_ipv6 else pinger.ping()
            elapsed = time.time() - t1

        count += 1

        if rtt is None:
            rtt_ms = None
            nbad += 1
            if pinger is None or pinger.exception is None:
                bar = fg_red + "timeout" + textdefault
            else:
                bar = fg_red + pinger.exception + textdefault
        else:
            ngood += 1

            # Round half away from zero, as Ruby does; Python's round() is banker's.
            rtt_ms = int(math.floor(rtt * 1000 + 0.5))

            template = (
                "0"
                + ".........|"
                + "10-------|"
                + "100======|"
                + "1000#####"
            )

            last = "|"
            if rtt_ms <= 0:
                index = 0
            else:
                index = int(math.log10(rtt_ms) * 10)
                if index > 39:
                    index = 39
                    last = "+"

            bg_color = bg_green
            if rtt_ms > 1000:
                bg_color = bg_red
            elif rtt_ms > 100:
                bg_color = bg_yellow

            # Python slices are half-open, so [:index+1] matches Ruby's [0..index].
            bar = (
                "["
                + fg_white + bg_color + bold + underline
                + template[: index + 1]
                + textdefault
                + template[index + 1:]
                + last
                + "]"
            )

        # Pad by visible width: the color escapes must not count toward the 20.
        dest_fmt = "%s%s%s%s" % (fg_yellow, dest, textdefault, " " * max(0, 20 - len(dest)))
        if rtt_ms is None:
            rtt_ms_fmt = ""
        else:
            rtt_ms_fmt = " %6.1fms" % rtt_ms
        print("%s%s %s [%d/%d OK]" % (dest_fmt, rtt_ms_fmt, bar, ngood, count), flush=True)

        if not parse_external_ping:
            if rtt is None:
                time.sleep(wait_seconds)
            elif elapsed < wait_seconds:
                time.sleep(wait_seconds - elapsed)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
